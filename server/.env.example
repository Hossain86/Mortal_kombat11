# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (Local)
# MONGODB_URI=mongodb://localhost:27017/mortal-kombat-tournament

# MongoDB Atlas Configuration (Production)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mortal-kombat-tournament?retryWrites=true&w=majority

# CORS Origin (Production frontend URL)
CORS_ORIGIN=http://localhost:3000
# For production, update to your Vercel frontend URL:
# CORS_ORIGIN=https://your-app.vercel.app
